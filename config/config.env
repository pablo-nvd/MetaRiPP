# =========================
# GENERAL
# =========================
THREADS=12

# =========================
# PATHS
# =========================

RAW_DIR="raw"
QC_DIR="filtered_reads"
CLEAN_DIR="clean_reads"
ASSEMBLY_DIR="assembly"
PRODIGAL_DIR="prodigal"
ANTISMASH_DIR="antismash"
BIGSCAPE_DIR="bigscape"
DEEPRIPP_DIR="deepripp"
RIPPMINER_DIR="rippminer"
LOG_DIR="logs"


# =========================
# BOWTIE2 INDEXES
# =========================
DBS_DIR="dbs"

PHIX_INDEX="$DBS_DIR/index_phix/phix"
HG_INDEX="$DBS_DIR/index_h38/GRCh38_noalt_as"

# =========================
# ASSEMBLY
# =========================
#ASSEMBLY_DIR=data/assembly
#PRODIGAL_DIR=data/prodigal

MEGAHIT_THREADS=16
MEGAHIT_MEMORY=0.85
MEGAHIT_LEN=1000

# =========================
# BGC ANALYSIS
# =========================
#ANTISMASH_DIR=data/antismash
#BIGSCAPE_DIR=data/bigscape

ANTISMASH_THREADS=16
BIGSCAPE_THREADS=16

# rutas a ejecutables (opcional si están en PATH)
ANTISMASH_BIN=antismash
BIGSCAPE_BIN=bigscape.py

# OPTIONAL MODULES
RUN_BIGSCAPE=false

# =========================
# DEEPRIPP
# =========================
#DEEPRIPP_DIR=data/deepripp
DEEPRIPP_THREADS=4
DEEPRIPP_BIN=bins/deepripp/deepRiPP.py
DEEPRIPP_MODELS=bins/deepripp/models

# =========================
# RIPPMINER
# =========================
RIPPMINER_BIN=bins/rippminer/run_rippminer.pl
#RIPPMINER_DIR=data/rippminer